GEMINI_API_KEY=your_api_key_here
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=your_api_key_here
# HuggingFace token for pyannote diarization (step 02b).
# Requires accepting model terms at all three:
#   https://huggingface.co/pyannote/speaker-diarization-3.1
#   https://huggingface.co/pyannote/segmentation-3.0
#   https://huggingface.co/pyannote/speaker-diarization-community-1
HF_TOKEN=your_hf_token_here
BENZINGA_API_KEY=your_token_here
ASKNEWS_API_KEY=your_api_key_here
# OR use OAuth client credentials:
# ASKNEWS_CLIENT_ID=your_id_here
# ASKNEWS_CLIENT_SECRET=your_secret_here
COLLECTION_NAME=earnings_calls
AUDIO_DIR=./data/audio
TRANSCRIPT_DIR=./data/transcripts
CLIPS_DIR=./data/audio_clips
