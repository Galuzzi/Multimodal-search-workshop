# Your own Gemini key — embeds your query text. Free tier: https://aistudio.google.com
GEMINI_API_KEY=your_api_key_here

# ── Qdrant connection ────────────────────────────────────────────────────────
# PARTICIPANTS: paste the shared workshop cluster URL + READ-ONLY key your
# instructor gives you (the cluster is already loaded with ~577 points).
#   QDRANT_URL   = https://<cluster>.<region>.cloud.qdrant.io:6333
#   QDRANT_API_KEY = <read-only key from the instructor>
# A read-only key can run every exercise (search/audio/news/recommend); it
# intentionally cannot run the ingestion pipeline (which would wipe the data).
#
# Running your own Qdrant instead? Either point QDRANT_URL at a local Docker
# instance (http://localhost:6333, no key needed), or leave QDRANT_URL empty to
# use embedded mode at QDRANT_PATH (defaults to ./data/qdrant_storage).
QDRANT_URL=
QDRANT_API_KEY=
# QDRANT_PATH=./data/qdrant_storage

# HuggingFace token for pyannote diarization (step 02b).
# Requires accepting model terms at all three:
#   https://huggingface.co/pyannote/speaker-diarization-3.1
#   https://huggingface.co/pyannote/segmentation-3.0
#   https://huggingface.co/pyannote/speaker-diarization-community-1
HF_TOKEN=your_hf_token_here
BENZINGA_API_KEY=your_token_here
ASKNEWS_API_KEY=your_api_key_here
# OR use OAuth client credentials:
# ASKNEWS_CLIENT_ID=your_id_here
# ASKNEWS_CLIENT_SECRET=your_secret_here
COLLECTION_NAME=earnings_calls
AUDIO_DIR=./data/audio
TRANSCRIPT_DIR=./data/transcripts
CLIPS_DIR=./data/audio_clips
